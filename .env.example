# Local development. In ECS these come from the task definition and Secrets Manager.
CONTROL_PLANE_ENVIRONMENT=local
CONTROL_PLANE_SEED_PATH=config/seed.yaml
CONTROL_PLANE_DYNAMODB_ENDPOINT=memory
CONTROL_PLANE_AUTH_DISABLED=true
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PUBLIC_URL=http://localhost:5173
CONTROL_PLANE_ALLOWED_ORIGINS=["http://localhost:5173"]

# Production values
# CONTROL_PLANE_TABLE_NAME=foxtrot-control-plane
# CONTROL_PLANE_DB_GATE_TABLE=
# CONTROL_PLANE_DB_GATE_NAMESPACE=foxtrot-db-operator
# CONTROL_PLANE_TRAFFIC_URL=http://traffic.internal:8001
# CONTROL_PLANE_GITHUB_CLIENT_ID=
# CONTROL_PLANE_GITHUB_ALLOWED_IDS=[]

# Secrets. Names can be changed with the *_SECRET settings; `aws:ID` reads Secrets Manager.
DB_ADAPTER_TOKEN=change-me
REDIS_ADAPTER_TOKEN=change-me
OBJECT_ADAPTER_TOKEN=change-me
TRAFFIC_SERVICE_TOKEN=change-me
WORKLOAD_TOKEN=change-me
GITHUB_CLIENT_SECRET=change-me

# Optional migration observability. Use the PUBLIC APP ingress, not the OAuth URL.
# CONTROL_PLANE_PUBLIC_PROBE_URL=https://app.example.com/api/migration-probe
# CONTROL_PLANE_PUBLIC_PROBE_SERVED_BY={"aws-web":"aws","gcp-web":"gcp"}
# CONTROL_PLANE_OBSERVATION_TOKEN_SECRET=env:OBSERVATION_TOKEN
# Inject OBSERVATION_TOKEN securely; do not commit its value.

# CP also publishes APP/PUBLIC snapshots and operation spans through the Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
# CONTROL_PLANE_PROMETHEUS_URL=http://127.0.0.1:9090
# CONTROL_PLANE_TEMPO_URL=http://127.0.0.1:3200

# Optional AI. Set the key only on the server; never use VITE_* for credentials.
# OPENAI_API_KEY=
# CONTROL_PLANE_AI_API_KEY_SECRET=aws:foxtrot/platform/openai-api-key
# CONTROL_PLANE_AI_MODEL=gpt-5-mini
# CONTROL_PLANE_AI_TIMEOUT_SECONDS=60
# CONTROL_PLANE_AI_MAX_OUTPUT_TOKENS=4000
# CONTROL_PLANE_AI_RETENTION_DAYS=30
# Resource metrics use server AWS/GCP credentials; HTTP metrics use Prometheus above.
