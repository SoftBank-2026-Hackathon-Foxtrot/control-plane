# Local development. In ECS these come from the task definition and Secrets Manager.
CONTROL_PLANE_ENVIRONMENT=local
CONTROL_PLANE_SEED_PATH=config/seed.yaml
CONTROL_PLANE_DYNAMODB_ENDPOINT=memory
CONTROL_PLANE_AUTH_DISABLED=true
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PUBLIC_URL=http://localhost:5173
CONTROL_PLANE_ALLOWED_ORIGINS=["http://localhost:5173"]

# Production values
# CONTROL_PLANE_TABLE_NAME=foxtrot-control-plane
# CONTROL_PLANE_DB_GATE_TABLE=
# CONTROL_PLANE_DB_GATE_NAMESPACE=foxtrot-db-operator
# CONTROL_PLANE_TRAFFIC_URL=http://traffic.internal:8001
# CONTROL_PLANE_GITHUB_CLIENT_ID=
# CONTROL_PLANE_GITHUB_ALLOWED_IDS=[]

# Secrets. Names can be changed with the *_SECRET settings; `aws:ID` reads Secrets Manager.
DB_ADAPTER_TOKEN=change-me
REDIS_ADAPTER_TOKEN=change-me
OBJECT_ADAPTER_TOKEN=change-me
TRAFFIC_SERVICE_TOKEN=change-me
WORKLOAD_TOKEN=change-me
GITHUB_CLIENT_SECRET=change-me

# Personal application configuration. Legacy seed migration is disabled by default.
# CONTROL_PLANE_SEED_OWNER_ID=github:12345
# CONTROL_PLANE_PERSONAL_CATALOG_PATHS={"github:12345":"config/personal.yaml"}
# CONTROL_PLANE_PERSONAL_SECRET_REFS={"github:12345":["arn:aws:secretsmanager:..."]}
# Server-approved ECS targets; users cannot supply roles, service ARNs or task templates.
# CONTROL_PLANE_RUNTIME_TARGETS={"github:12345/aws":{"provider":"ecs","cluster":"approved","service":"approved","taskDefinition":"approved:1","container":"app","region":"ap-northeast-2"}}
