#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
. /etc/os-release
test "$ID" = ubuntu && test "$VERSION_CODENAME" = noble
apt-get update
apt-get install -y curl ca-certificates python3 iptables
curl --fail --silent --show-error --location https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg
curl --fail --silent --show-error --location https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list
apt-get update
apt-get install -y tailscale=${version}
%{ if cloud == "aws" ~}
apt-get install -y awscli
%{ endif ~}
cat >/etc/sysctl.d/99-foxtrot-tailscale.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2
SYSCTL
sysctl --system
install -d -m 0700 /opt/foxtrot-router
cat >/opt/foxtrot-router/configure.py <<'PYTHON'
import base64
import json
import os
import subprocess
import urllib.request
from pathlib import Path

config = json.loads(base64.b64decode("${config}"))
flags = [
    "--advertise-routes=" + ",".join(config["advertised_cidrs"]),
    "--accept-routes=true", "--snat-subnet-routes=false", "--accept-dns=false",
    "--hostname=" + config["name"],
]
# Clamp MSS so database connections survive the smaller encrypted-path MTU.
mss = ["iptables", "-t", "mangle", "-C", "FORWARD", "-o", "tailscale0", "-p", "tcp",
       "--tcp-flags", "SYN,RST", "SYN", "-j", "TCPMSS", "--clamp-mss-to-pmtu"]
if subprocess.run(mss, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
    mss[3] = "-A"
    subprocess.run(mss, check=True)
status = subprocess.run(["tailscale", "status", "--json"], capture_output=True)
if status.returncode == 0 and json.loads(status.stdout).get("BackendState") == "Running":
    subprocess.run(["tailscale", "set", *flags], check=True)
else:
    if config["cloud"] == "aws":
        key = subprocess.check_output([
            "aws", "secretsmanager", "get-secret-value", "--secret-id", config["secret_ref"],
            "--region", config["region"], "--query", "SecretString", "--output", "text",
        ]).strip()
    else:
        request = urllib.request.Request(
            "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token",
            headers={"Metadata-Flavor": "Google"},
        )
        with urllib.request.urlopen(request, timeout=10) as response:
            token = json.load(response)["access_token"]
        request = urllib.request.Request(
            "https://secretmanager.googleapis.com/v1/" + config["secret_ref"] + "/versions/latest:access",
            headers={"Authorization": "Bearer " + token},
        )
        with urllib.request.urlopen(request, timeout=20) as response:
            key = base64.b64decode(json.load(response)["payload"]["data"])
    path = Path("/run/foxtrot-tailscale-auth")
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as output:
            output.write(key)
        key = b""
        subprocess.run(["tailscale", "up", "--auth-key=file:" + str(path), "--timeout=60s", *flags],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    finally:
        path.unlink(missing_ok=True)
PYTHON
chmod 0700 /opt/foxtrot-router/configure.py
cat >/etc/systemd/system/foxtrot-tailscale-router.service <<'UNIT'
[Unit]
Description=Foxtrot persistent Tailscale subnet router
Wants=network-online.target
After=network-online.target tailscaled.service
Requires=tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/foxtrot-router/configure.py
Restart=on-failure
RestartSec=15
TimeoutStartSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now tailscaled.service
systemctl enable --now foxtrot-tailscale-router.service
